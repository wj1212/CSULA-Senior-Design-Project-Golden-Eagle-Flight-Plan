# Copy this file to .env and fill in your local values.
# .env is git-ignored — each developer maintains their own.

# For web dev: http://localhost:4000/api
# For mobile dev: http://<YOUR_LAN_IP>:4000/api
# Run `ipconfig` (Windows) or `ifconfig` (Mac/Linux) to find your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
